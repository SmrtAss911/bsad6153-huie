# Copy this file to .env and fill in real values there.
# This file holds variable NAMES only. Never put a real value in it:
# it is committed to GitHub, and anyone can read it.

# Placeholder used by the Week 1 setup check. Any fake value is fine.
TEST_SECRET=

# Data API keys (Week 1). Mouser is the primary source; Digi-Key v4 is the optional backup.
MOUSER_API_KEY=
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=

# Database owner connection, used ONLY by the sync pipeline (Weeks 2-3).
# Use Supabase's Session pooler connection string.
DATABASE_URL=

# Read-only role used by the website, chatbot, and golden-question checker (Week 2).
APP_DATABASE_URL=

# The agent's own limited role (Week 6).
AGENT_DATABASE_URL=

# LLM key: you need only the one for the provider you use (Week 5).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Password for the signed-in part of your website: the chatbot and agent (Week 5).
APP_PASSWORD=
